<!doctype html>
<html lang="en-GB">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  {%- set pageTitle = (title + " - ayeo") if title else "Compass for Claude Code: process that matches each change - ayeo" %}
  {%- set pageDescription = summary or subtitle or site.description %}
  <title>{{ pageTitle }}</title>
  <meta name="description" content="{{ pageDescription }}">
  <link rel="canonical" href="{{ site.url }}{{ page.url }}">
  <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)">
  <meta name="theme-color" content="#0b0b0e" media="(prefers-color-scheme: dark)">
  <meta property="og:type" content="{{ 'article' if layout == 'post.njk' else 'website' }}">
  <meta property="og:site_name" content="ayeo">
  <meta property="og:title" content="{{ title or 'Compass for Claude Code: process that matches each change' }}">
  <meta property="og:description" content="{{ pageDescription }}">
  <meta property="og:url" content="{{ site.url }}{{ page.url }}">
  <meta property="og:image" content="{{ site.url }}/assets/og.png">
  <meta name="twitter:card" content="summary_large_image">
  <link rel="icon" href="/favicon.ico" sizes="32x32">
  <link rel="icon" href="/assets/mark-192.png" type="image/png">
  <link rel="apple-touch-icon" href="/assets/mark-192.png">
  <link rel="alternate" type="application/atom+xml" title="ayeo news" href="/news/feed.xml">
  <link rel="preload" href="/assets/fonts/plex-sans-400.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="/assets/fonts/plex-sans-600.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="{{ '/assets/css/site.css' | versioned }}">
  <script>document.documentElement.classList.add("js");try{var t=localStorage.getItem("ayeo-compass-theme");if(t==="light"||t==="dark")document.documentElement.setAttribute("data-theme",t)}catch(e){}</script>
</head>
<body class="{{ bodyClass }}">
  <a class="skip" href="#main">Skip to content</a>
  <header class="masthead">
    <div class="wrap masthead-inner">
      <a class="brand" href="/" aria-label="ayeo home">
        {%- include "mark-ayeo.njk" %}
        <span>ayeo</span>
      </a>
      <nav aria-label="Main">
        <a href="/#compass">Compass</a>
        <a href="/#teams">For teams</a>
        <a href="/news/" {% if '/news/' in page.url %}aria-current="page"{% endif %}>News</a>
        <a href="{{ site.githubOrg }}">GitHub</a>
      </nav>
      <div class="mast-right">
        <button class="theme" type="button" id="theme-toggle" data-mode="auto" aria-label="Theme: follows your system. Click to change">
        <svg class="ico ico-auto" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 3a9 9 0 0 1 0 18z" fill="currentColor" stroke="none"/></svg>
        <svg class="ico ico-light" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
        <svg class="ico ico-dark" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
        <span class="theme-label">Auto</span>
        </button>
      </div>
    </div>
  </header>

  <main id="main">
    {{ content | safe }}
  </main>

  <footer class="colophon">
    <div class="wrap colophon-inner">
      <p>{% include "mark-ayeo.njk" %} ayeo makes Compass, an open-source plugin for Claude Code.</p>
      <ul>
        <li><a href="{{ site.compass.url }}">Compass on GitHub</a></li>
        <li><a href="/news/">News</a></li>
        <li><a href="/news/feed.xml">Atom feed</a></li>
      </ul>
      <p class="small">Compass is released under the {{ site.compass.licence }} licence. This site sets no cookies and runs no tracking.</p>
    </div>
  </footer>
  <script src="{{ '/assets/js/site.js' | versioned }}" defer></script>
  {%- if scripts %}{% for s in scripts %}
  <script src="{{ s | versioned }}" defer></script>{% endfor %}{% endif %}
</body>
</html>
